@echo off
rem Dune: Spice Wars co-op Conquest mod (unofficial) - installer. Put this file into the game folder (next to
rem D4X.exe), close the game, double-click it once. Then start the game as usual (Steam). Backups are kept.
set "COOP_DIR=%~dp0"
set "COOP_SELF=%~f0"
powershell -NoProfile -ExecutionPolicy Bypass -Command "iex ((Get-Content -Raw -LiteralPath $env:COOP_SELF) -split ('#POWER'+'SHELL#'),2)[1]"
echo.
pause
exit /b
#POWERSHELL#
$ErrorActionPreference = 'Stop'
$dir = $env:COOP_DIR
$build = 'coop90'
$log = Join-Path $dir 'DuneCoop.log'
function Say($t, $c = 'Gray') { Write-Host $t -ForegroundColor $c; Add-Content -LiteralPath $log -Value $t -Encoding UTF8 }
function Sha($p) { (Get-FileHash -Algorithm SHA256 -LiteralPath $p).Hash.ToLower() }
function Build($old, $b64) {
    $raw = [Convert]::FromBase64String($b64)
    $in = New-Object IO.Compression.DeflateStream((New-Object IO.MemoryStream(,$raw)), [IO.Compression.CompressionMode]::Decompress)
    $ms = New-Object IO.MemoryStream; $in.CopyTo($ms); $d = $ms.ToArray()
    $out = New-Object IO.MemoryStream
    $i = 0
    while ($i -lt $d.Length) {
        if ($d[$i] -eq 67) { $o = [int][BitConverter]::ToUInt32($d, $i + 1); $n = [int][BitConverter]::ToUInt32($d, $i + 5); $out.Write($old, $o, $n); $i += 9 }
        else { $n = [int][BitConverter]::ToUInt32($d, $i + 1); $out.Write($d, $i + 5, $n); $i += 5 + $n }
    }
    return ,$out.ToArray()
}
$files = @(
    @{ name = 'hlboot.dat'; old = '9c7c1044d7c6b63647fb3f1435b8eb99f6b22dbf31997fc1db6f5a43a0e360cd'; new = 'eedc811f0434b73875d1236eb3130325b813237dd35c61879d27ec71449362fc'; delta = ''; restore = ''; prev = @(@{ build = 'coop73'; sha = 'e4c036affe73adefbdb516459a72f6aa29229c10e1dd03febce142f8e2879018'; restore = '' }, @{ build = 'coop74'; sha = '481714221be0079d9166149232ca2019a7e2220c572e3f38c516222c54dd7426'; restore = '' }, @{ build = 'coop75'; sha = '210e81e268a6d950fd98df010346833abf1e00df1c431fde42f2f6d9f1dd3379'; restore = '' }, @{ build = 'coop76'; sha = '858af1aeb0bbc5e03855ca4fddd5e5ecbac4297885740710d1a9e8c1a5fbcc21'; restore = '' }, @{ build = 'coop77'; sha = '41d068f878ce75ff5870bc15c8aaef7004e7ca380135990ba9ba092692cc7dc2'; restore = '' }, @{ build = 'coop78'; sha = '6b7dffe1052db39c9520c7d2802d39ad78399ec727b3f8e7a4e093692bf1d85f'; restore = '' }, @{ build = 'coop79'; sha = 'e5ccfa35c4342c8a2272f90537a9c7f2622a8f1dbf21aa390d693a93f0c382a7'; restore = '' }, @{ build = 'coop80'; sha = '01435811a8284b78cb84c7c4a137596bb445a3579812f9669d6c670313749b77'; restore = '' }, @{ build = 'coop81'; sha = 'dcf86bc0bc878fbce23fc380a41870d4ad0c7605e4dc575a1813522624ac386a'; restore = '' }, @{ build = 'coop82'; sha = 'd04945caaf597fa522ff37fc5f907e87ea959e4bca44b0b8dc740a62d17af824'; restore = '' }, @{ build = 'coop83'; sha = 'a4a6d979ecea98f17ec326e17603582f6391e2b1f4c5e047d4eb5dd86b24aa08'; restore = '' }, @{ build = 'coop84'; sha = '9ac9285deb30c3f587c6c1c8b8e50e7fabf9613afddc9dd72733ab9bcecc1730'; restore = '' }, @{ build = 'coop85'; sha = '7e4b54dc1fe8eb758fdf9b7d2335b5fe97d5bcf78f35f9cfae5b1e20661569e6'; restore = '' }, @{ build = 'coop86'; sha = 'f457c43c9885e3c5d4a25fad783f4d0fe9685422d3915542b59d14adacfb17b9'; restore = '' }, @{ build = 'coop87'; sha = '4f99644e0d0511d50ee24599a4811f75d3f9cc901104997b20f2ea028ebe8257'; restore = '' }, @{ build = 'coop88'; sha = '73e5e834e75a8f7a47190cd12c6e568830e50340c965e39c8b73f687bb939808'; restore = '' }, @{ build = 'coop89'; sha = '8ad357d86191338a5381455631da77161e4f9ad61b013cc25f92991335c036d7'; restore = '' }) }
    @{ name = 'hlbootdx.dat'; old = '4cbadecc1160618369482acec3133ad21e109f11ce492cebca72027a68848703'; new = 'b1bc08235d35ccdee151197afc688dc41fb193743076841d88d177fa0d0738df'; delta = ''; restore = ''; prev = @(@{ build = 'coop73'; sha = 'f4efa9012067fef4f5350b8de53a79442d69cef3cd46a9fa326a992dbdf79073'; restore = '' }, @{ build = 'coop74'; sha = '76f65225e7dfceb8d9cf58f60fe07538894c9919cb238acf0694d3e7f29822cc'; restore = '' }, @{ build = 'coop75'; sha = '9c02ac0dc78e5ab465c9acb88d5471c7f86d1d88b4599693952f4d92dff616f2'; restore = '' }, @{ build = 'coop76'; sha = 'd004a89038c47d5c17a4e48318855e2cf6406b22b63abc96658d478725adccf8'; restore = '' }, @{ build = 'coop77'; sha = '55fbbca78c94c34d4a605ee5781505051d1757280a616b90ea6c4f2ce5acd891'; restore = '' }, @{ build = 'coop78'; sha = '64986aba6ad2895e56f4760d3714640d73f949ef9f2832f87d4c4c109ac6f15d'; restore = '' }, @{ build = 'coop79'; sha = '8825578b8b4c3ec1940e6c6a1dc316389b23b09445b9a2a097ce6f9176a7e7ab'; restore = '' }, @{ build = 'coop80'; sha = '0dd8f8326dc6bb32ed18532c84c7f3cacd2e95cb4059f3975d02d66195ddd242'; restore = '' }, @{ build = 'coop81'; sha = '40562975bfe95873a831362ba1d3818adcafc1c16bf13a5d04ea7a57f8fa3a9b'; restore = '' }, @{ build = 'coop82'; sha = '71d2f8cfb7e8d1d949447e4620c04dcdcd0a704a253c9b4e2435d2e3da4d6c35'; restore = '' }, @{ build = 'coop83'; sha = '1bcb139edaae9d7069557902dbc028b01e6bca5618fb7b746adc6425f867a762'; restore = '' }, @{ build = 'coop84'; sha = '61fbc69d62ebb5b82803a0d33afc19d91571b821c6442c1f72e437668751d455'; restore = '' }, @{ build = 'coop85'; sha = 'c7f9a28c88e2c243b2c799534d9c2d0871e5614d63ab8cccb9b0c2659e50ffd0'; restore = '' }, @{ build = 'coop86'; sha = '9af1f895f8ff94454739a73cb08ba8381e4f8913a16d10ad65b76976477062b6'; restore = '' }, @{ build = 'coop87'; sha = 'b0527d9f6ea145dcc8ca7488e61b44ec6666ea400a80f037999d0b72d32891d1'; restore = '' }, @{ build = 'coop88'; sha = 'eff059a217c6b0092d3b2fdf62c748dfb80595a4e74fc64bb2e1c5efa67251fa'; restore = '' }, @{ build = 'coop89'; sha = 'aff06351f1abdc93ff118f9ec95b81dec347a957653eead080922a0f1b7cce1e'; restore = '' }) }
)
$ok = 0; $bad = 0
try {
    Set-Content -LiteralPath $log -Value "DuneCoop installer $build - $(Get-Date -Format s)" -Encoding UTF8
    Say "Dune: Spice Wars co-op mod $build" 'Cyan'
    Say "Folder: $dir"
    if (-not (Test-Path (Join-Path $dir 'D4X.exe'))) { throw 'D4X.exe is not here. Put DuneCoop.cmd into the game folder (Steam: right-click the game - Manage - Browse local files).' }
    if (Get-Process d4x -ErrorAction SilentlyContinue) { throw 'The game is running. Close it and run this file again.' }
    foreach ($f in $files) {
        $path = Join-Path $dir $f.name; $bak = "$path.coop_backup"
        if (-not (Test-Path $path)) { Say "$($f.name): not in this folder, skipped"; continue }
        $cur = Sha $path
        $bakOk = (Test-Path $bak) -and ((Sha $bak) -eq $f.old)
        if ($cur -eq $f.new) {
            if (-not $bakOk) {                      # stale backup (a game update came after an older install): repair it
                $orig = Build ([IO.File]::ReadAllBytes($path)) $f.restore
                [IO.File]::WriteAllBytes("$bak.tmp", $orig)
                if ((Sha "$bak.tmp") -eq $f.old) { Move-Item -LiteralPath "$bak.tmp" -Destination $bak -Force; Say "$($f.name): backup repaired" }
                else { Remove-Item -LiteralPath "$bak.tmp" }
            }
            Say "$($f.name): $build is already installed" 'Green'; $ok++; continue
        }
        $orig = $null
        if ($cur -eq $f.old) { Copy-Item -LiteralPath $path -Destination $bak -Force; $orig = [IO.File]::ReadAllBytes($path) }   # fresh original
        elseif ($bakOk) { $orig = [IO.File]::ReadAllBytes($bak) }                               # an older co-op build of this game version
        else {
            foreach ($p in $f.prev) {                                                            # a known older co-op build
                if ($cur -eq $p.sha) {
                    $o = Build ([IO.File]::ReadAllBytes($path)) $p.restore
                    [IO.File]::WriteAllBytes("$bak.tmp", $o)
                    if ((Sha "$bak.tmp") -eq $f.old) { Move-Item -LiteralPath "$bak.tmp" -Destination $bak -Force; $orig = $o; Say "$($f.name): older co-op build $($p.build) found, original restored as backup" }
                    else { Remove-Item -LiteralPath "$bak.tmp" }
                }
            }
        }
        if (-not $orig) { Say "$($f.name): unknown game version (sha $cur) - NOT patched. In Steam: right-click the game - Properties - Installed Files - Verify integrity, then run this file again. If it still fails, send DuneCoop.log to the host." 'Red'; $bad++; continue }
        $bytes = Build $orig $f.delta
        $tmp = "$path.coop_tmp"
        [IO.File]::WriteAllBytes($tmp, $bytes)
        if ((Sha $tmp) -ne $f.new) { Remove-Item -LiteralPath $tmp; Say "$($f.name): patched file check failed - NOT patched" 'Red'; $bad++; continue }
        Move-Item -LiteralPath $tmp -Destination $path -Force
        Say "$($f.name): $build installed (backup: $($f.name).coop_backup)" 'Green'; $ok++
    }
    if ($ok -gt 0 -and $bad -eq 0) {
        Say ''
        Say "DONE. Start the game as usual (Steam). No need to run this file again until the host sends a new one." 'Green'
        Say "Check: the game's game.log has the line  ---- Menu.new() ---- [co-op mod $build]"
    } else { Say ''; Say 'NOT installed. Send the file DuneCoop.log (next to this file) to the host.' 'Red' }
} catch { Say "ERROR: $($_.Exception.Message)" 'Red' }
